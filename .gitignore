# 一般的な隠しファイル・ディレクトリ
.*
!.gitignore  # .gitignore は除外しない
!.gitkeep
# !.github  # GitHubの設定フォルダは必要なら残す

# キャッシュや開発環境の設定ファイル
.cache/
.vscode/
.vscode-server/
.idea/
__pycache__/
*.swp  # Vimの一時ファイル
*.swo
.gitconfig

# SSHや認証情報（重要！）
.ssh/
.gnupg/

# OSやエディタの不要ファイル
.DS_Store
.bash_history
Thumbs.db

# ROS2のビルド・ログ関連（Git管理不要）
build/
install/
log/
build_foxy/
install_foxy/
log_foxy/
bags/
# 対話ログ・作業レポートはローカル保管のみとし、GitHubへは含めない。
notes/codex_sessions/
notes/reports/
# 解析結果は位置情報を含み得るため、FINDINGS.mdを含めてすべてローカルに保管する。
/src/pm_evaluation/results/

# credentials / local configs
src/pm_config/config/*secret*.yaml
src/pm_config/config/*private*.yaml

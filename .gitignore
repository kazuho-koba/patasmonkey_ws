# 一般的な隠しファイル・ディレクトリ
.*
!.gitignore  # .gitignore は除外しない
!.gitkeep
# !.github  # GitHubの設定フォルダは必要なら残す

# キャッシュや開発環境の設定ファイル
.cache/
.vscode/
.vscode-server/
.idea/
__pycache__/
*.swp  # Vimの一時ファイル
*.swo
.gitconfig

# SSHや認証情報（重要！）
.ssh/
.gnupg/

# OSやエディタの不要ファイル
.DS_Store
.bash_history
Thumbs.db

# ROS2のビルド・ログ関連（Git管理不要）
build/
install/
log/
build_foxy/
install_foxy/
log_foxy/
bags/
# Evaluation outputs may contain raw GNSS/location data. Keep them private by
# default, but retain distilled, manually reviewed findings in version control.
src/pm_evaluation/results/**
!src/pm_evaluation/results/**/
!src/pm_evaluation/results/**/FINDINGS.md

# credentials / local configs
src/pm_config/config/*secret*.yaml
src/pm_config/config/*private*.yaml

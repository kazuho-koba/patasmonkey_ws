<?xml version="1.0" encoding="UTF-8"?>
<!-- participantごと2 MiBの有限SHM通信buffer。遠隔通信とdiscoveryのUDPv4は残す。
     QoS・画像設定は変更せず、bag全体をRAMへ置く方式でもない。 -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor><transport_id>pm_udp</transport_id><type>UDPv4</type></transport_descriptor>
    <transport_descriptor><transport_id>pm_shm</transport_id><type>SHM</type><segment_size>2097152</segment_size></transport_descriptor>
  </transport_descriptors>
  <participant profile_name="pm_transport" is_default_profile="true">
    <rtps><userTransports><transport_id>pm_udp</transport_id><transport_id>pm_shm</transport_id></userTransports><useBuiltinTransports>false</useBuiltinTransports></rtps>
  </participant>
</profiles>

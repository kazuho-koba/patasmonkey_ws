<?xml version="1.0" encoding="utf-8"?>
<robot name="patasmonkey">

	<link name="base_link"/>
	<!-- 最初は車体主要部をbase_linkとしていたが、CADと座標系を合わせるために回したりしたいので大きさゼロの仮想base_linkを定義し、車体主要部リンク（body）をぶら下げる形とした -->

	<link name="body">
		<inertial>
			<mass value="8.878175441817634"/>
			<origin rpy="0 0 0" xyz="3.605945130529295e-17 -1.370259149601132e-15 0.061700238722655266"/>
			<inertia ixx="0.180154674257629" ixy="5.122274160385088e-17" ixz="1.9752846156165697e-17" iyy="0.0824654290636114" iyz="4.531262737562093e-16" izz="0.22992441349024134"/>
		</inertial>
		<collision name="body_collision">
			<origin rpy="0.0 -0.0 0.0" xyz="0.0 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/body.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="body_visual">
			<origin rpy="0.0 -0.0 0.0" xyz="0.0 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/body.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheelarm_rightrear">
		<inertial>
			<mass value="0.11129201234266223"/>
			<origin rpy="0 0 0" xyz="0.011864073144704071 -0.11539021627920214 -0.057812154810178235"/>
			<inertia ixx="0.00044081613489392916" ixy="1.3004019884530748e-05" ixz="1.1126423064250356e-05" iyy="0.00011346844003993653" iyz="-0.0001751098519904491" izz="0.00034575987847753427"/>
		</inertial>
		<collision name="wheelarm_rightrear_collision">
			<origin rpy="0.0 0.4363323129985771 -1.5707963267948966" xyz="1.3877787807814457e-17 7.50720839698537e-18 -1.3877787807814457e-17"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_1.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheelarm_rightrear_visual">
			<origin rpy="0.0 0.4363323129985771 -1.5707963267948966" xyz="1.3877787807814457e-17 7.50720839698537e-18 -1.3877787807814457e-17"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_1.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheelarm_rightfront">
		<inertial>
			<mass value="0.1112920123426623"/>
			<origin rpy="0 0 0" xyz="0.002309209808224133 0.11539021627920193 -0.05781215481017842"/>
			<inertia ixx="0.00044081613489390466" ixy="-7.771667430638374e-06" ixz="8.488137973844268e-06" iyy="0.00011326169495537535" iyz="0.00017510985199043966" izz="0.00034555313339295284"/>
		</inertial>
		<collision name="wheelarm_rightfront_collision">
			<origin rpy="3.141592653589793 0.4363323129985816 1.5707963267948966" xyz="0.010000000000000009 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_2.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheelarm_rightfront_visual">
			<origin rpy="3.141592653589793 0.4363323129985816 1.5707963267948966" xyz="0.010000000000000009 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_2.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheelarm_leftfront">
		<inertial>
			<mass value="0.11129201234266223"/>
			<origin rpy="0 0 0" xyz="-0.011864073144703974 0.115390216279202 -0.057812154810178505"/>
			<inertia ixx="0.0004408161348938993" ixy="1.3004019884530748e-05" ixz="-1.1126423064250356e-05" iyy="0.00011346844003993298" iyz="0.00017510985199043798" izz="0.0003457598784775087"/>
		</inertial>
		<collision name="wheelarm_leftfront_collision">
			<origin rpy="0.0 0.4363323129985823 1.5707963267948966" xyz="0.0 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_1.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheelarm_leftfront_visual">
			<origin rpy="0.0 0.4363323129985823 1.5707963267948966" xyz="0.0 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_1.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheelarm_leftrear">
		<inertial>
			<mass value="0.1112920123426623"/>
			<origin rpy="0 0 0" xyz="-0.002309209808224133 -0.11539021627920193 -0.05781215481017848"/>
			<inertia ixx="0.00044081613489389967" ixy="-7.771667430638374e-06" ixz="-8.488137973844356e-06" iyy="0.00011326169495537428" iyz="-0.00017510985199043806" izz="0.00034555313339294997"/>
		</inertial>
		<collision name="wheelarm_leftrear_collision">
			<origin rpy="3.141592653589793 0.4363323129985823 -1.5707963267948966" xyz="-0.010000000000000009 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_2.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheelarm_leftrear_visual">
			<origin rpy="3.141592653589793 0.4363323129985823 -1.5707963267948966" xyz="-0.010000000000000009 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheelarm_2.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheel_rightrear">
		<inertial>
			<mass value="0.6459736269326636"/>
			<origin rpy="0 0 0" xyz="0.02500000000000005 -8.548717289613705e-14 -3.995788481992932e-14"/>
			<inertia ixx="0.0038053875071388916" ixy="2.842170943040401e-18" ixz="1.226796442210798e-18" iyy="0.002037271592695285" iyz="2.1636328284557748e-13" izz="0.0020372715923322174"/>
		</inertial>
		<collision name="wheel_rightrear_collision">
			<origin rpy="0.0 -0.4363323129985797 1.5707963267948966" xyz="0.05000000000000002 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheel_rightrear_visual">
			<origin rpy="0.0 -0.4363323129985797 1.5707963267948966" xyz="0.05000000000000002 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheel_rightfront">
		<inertial>
			<mass value="0.6459736269326636"/>
			<origin rpy="0 0 0" xyz="0.025000000000000022 -8.554268404736831e-14 3.978946078869727e-14"/>
			<inertia ixx="0.0038053875071388916" ixy="-2.842170943040401e-18" ixz="4.3021142204224814e-20" iyy="0.002037271592695302" iyz="-2.163487167194944e-13" izz="0.0020372715923322004"/>
		</inertial>
		<collision name="wheel_rightfront_collision">
			<origin rpy="0.0 0.4363323129985819 1.5707963267948966" xyz="0.04999999999999999 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheel_rightfront_visual">
			<origin rpy="0.0 0.4363323129985819 1.5707963267948966" xyz="0.04999999999999999 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheel_leftfront">
		<inertial>
			<mass value="0.6459736269326636"/>
			<origin rpy="0 0 0" xyz="-0.02500000000000005 8.545941732052142e-14 -3.9957891596192896e-14"/>
			<inertia ixx="0.0038053875071388916" ixy="2.842170943040401e-18" ixz="-1.2261025528204072e-18" iyy="0.0020372715926952906" iyz="-2.1636328284557748e-13" izz="0.0020372715923322117"/>
		</inertial>
		<collision name="wheel_leftfront_collision">
			<origin rpy="0.0 -0.4363323129985824 -1.5707963267948966" xyz="-0.05000000000000002 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheel_leftfront_visual">
			<origin rpy="0.0 -0.4363323129985824 -1.5707963267948966" xyz="-0.05000000000000002 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>
	<link name="wheel_leftrear">
		<inertial>
			<mass value="0.6459736269326636"/>
			<origin rpy="0 0 0" xyz="-0.025000000000000022 8.554268404736831e-14 3.9789454012433695e-14"/>
			<inertia ixx="0.0038053875071388916" ixy="0.0" ixz="-4.3021142204224814e-20" iyy="0.002037271592695305" iyz="2.163487167194944e-13" izz="0.002037271592332195"/>
		</inertial>
		<collision name="wheel_leftrear_collision">
			<origin rpy="0.0 0.4363323129985823 -1.5707963267948966" xyz="-0.04999999999999999 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		<visual name="wheel_leftrear_visual">
			<origin rpy="0.0 0.4363323129985823 -1.5707963267948966" xyz="-0.04999999999999999 0.0 0.0"/>
			<geometry>
				<mesh filename="package://pm_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</visual>
	</link>

	<!-- HWT905-RS485 IMU -->
	<link name="wit_imu_link">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
			<box size="0.04 0.04 0.015"/>
			</geometry>
		</visual>
	</link>

	<!-- OAK-D S2 body/reference point -->
	<link name="oakd_link">
		<visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
			<box size="0.09 0.03 0.025"/>
		</geometry>
		</visual>
	</link>
	<!-- OAK-D internal IMU frame -->
	<link name="oakd_imu_link"/>
	<!-- Mono camera physical frames: ROS body-style frames, x forward, y left, z up -->
  	<link name="cam0_link"/>
  	<link name="cam1_link"/>
	<!-- Mono camera optical frames: x right, y down, z forward -->
	<link name="cam0_optical_frame"/>
	<link name="cam1_optical_frame"/>
	<!-- RGB camera frame -->
	<link name="rgb_camera_link"/>
	<link name="rgb_camera_optical_frame"/>

	<!-- GPSのリンク（アンテナ位置を基準） -->
	<link name="gps_link"/>

	<!-- 大きさを持たないbase_linkから車体主要部リンクであるbodyに回転した固定リンクを貼ることで、CADの座標系からROS 2座標系に変換（X座標が車両前方になるようにする） -->
	<joint name="base_link_to_body" type="fixed">
		<parent link="base_link"/>
		<child link="body"/>
		<origin xyz="0 0 0" rpy="0 0 -1.57079632679"/>
	</joint>
	<joint name="wheelarmjoint_rightrear" type="continuous">
		<parent link="body"/>
		<child link="wheelarm_rightrear"/>
		<origin rpy="0 0 0" xyz="0.11999999999999998 -7.50720839698537e-18 0.10000000000000002"/>
		<axis xyz="-1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelarmjoint_rightfront" type="continuous">
		<parent link="body"/>
		<child link="wheelarm_rightfront"/>
		<origin rpy="0 0 0" xyz="0.13 4.440892098500626e-18 0.10000000000000002"/>
		<axis xyz="-1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelarmjoint_leftfront" type="continuous">
		<parent link="body"/>
		<child link="wheelarm_leftfront"/>
		<origin rpy="0 0 0" xyz="-0.12 0.0 0.1"/>
		<axis xyz="1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelarmjoint_leftrear" type="continuous">
		<parent link="body"/>
		<child link="wheelarm_leftrear"/>
		<origin rpy="0 0 0" xyz="-0.13 0.0 0.1"/>
		<axis xyz="1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelaxis_rightrear" type="continuous">
		<parent link="wheelarm_rightrear"/>
		<child link="wheel_rightrear"/>
		<origin rpy="0 0 0" xyz="0.048000000000000306 -0.16012172781242637 -0.10004368005208156"/>
		<axis xyz="-1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelaxis_rightfront" type="continuous">
		<parent link="wheelarm_rightfront"/>
		<child link="wheel_rightfront"/>
		<origin rpy="0 0 0" xyz="0.03800000000000012 0.16012172781242617 -0.10004368005208177"/>
		<axis xyz="-1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelaxis_leftfront" type="continuous">
		<parent link="wheelarm_leftfront"/>
		<child link="wheel_leftfront"/>
		<origin rpy="0 0 0" xyz="-0.04800000000000004 0.16012172781242623 -0.10004368005208186"/>
		<axis xyz="-1.0 0.0 0.0"/>
	</joint>
	<joint name="wheelaxis_leftrear" type="continuous">
		<parent link="wheelarm_leftrear"/>
		<child link="wheel_leftrear"/>
		<origin rpy="0 0 0" xyz="-0.038000000000000006 -0.16012172781242623 -0.10004368005208186"/>
		<axis xyz="-1.0 0.0 0.0"/>
	</joint>

	<joint name="base_link_to_wit_imu_link" type="fixed">
		<parent link="base_link"/>
		<child link="wit_imu_link"/>

		<!-- 要実測: base_link原点からIMU中心までの位置 [m] -->
		<origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
	</joint>

	<!-- base_link -> OAK-D center.
       TODO: replace x/y/z with measured mounting position.
       Current assumption: OAK-D center is directly above base_link by 0.28 m. -->
	<joint name="base_link_to_oakd_link" type="fixed">
		<parent link="base_link"/>
		<child link="oakd_link"/>
		<origin xyz="0.0 0.0 0.28" rpy="0.0 0.0 0.0"/>
	</joint>
	<!-- OAK-D internal IMU.
       Approximate placement from Kalibr: close to cam1/right side.
       For TF tree use, keeping it at oakd_link is acceptable unless precise IMU visualization is needed. -->
	<joint name="oakd_link_to_oakd_imu_link" type="fixed">
		<parent link="oakd_link"/>
		<child link="oakd_imu_link"/>
		<origin xyz="0.0 0.0 0.0" rpy="-1.57079632679 0.0 1.57079632679"/>
	</joint>
	<!-- cam0 = left mono camera.
       Baseline from Kalibr: approximately 0.07533 m, so half baseline is 0.0376655 m. -->
	<joint name="oakd_link_to_cam0_link" type="fixed">
		<parent link="oakd_link"/>
		<child link="cam0_link"/>
		<origin xyz="0.0 0.0376655 0.0" rpy="0.0 0.0 0.0"/>
	</joint>
	<!-- cam1 = right mono camera -->
	<joint name="oakd_link_to_cam1_link" type="fixed">
		<parent link="oakd_link"/>
		<child link="cam1_link"/>
		<origin xyz="0.0 -0.0376655 0.0" rpy="0.0 0.0 0.0"/>
	</joint>

	<!-- Convert ROS camera link frame to optical frame.
       ROS link:    x forward, y left, z up
       Optical:     x right,   y down, z forward
       rpy = -90deg roll, 0 pitch, -90deg yaw -->
	<joint name="cam0_link_to_cam0_optical_frame" type="fixed">
		<parent link="cam0_link"/>
		<child link="cam0_optical_frame"/>
		<origin xyz="0.0 0.0 0.0" rpy="-1.57079632679 0.0 -1.57079632679"/>
	</joint>
	<joint name="cam1_link_to_cam1_optical_frame" type="fixed">
		<parent link="cam1_link"/>
		<child link="cam1_optical_frame"/>
		<origin xyz="0.0 0.0 0.0" rpy="-1.57079632679 0.0 -1.57079632679"/>
	</joint>

	<!-- RGB camera is assumed to be at OAK-D center.
       Adjust if EEPROM/Kalibr gives a more precise RGB extrinsic later. -->
	<joint name="oakd_link_to_rgb_camera_link" type="fixed">
		<parent link="oakd_link"/>
		<child link="rgb_camera_link"/>
		<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
	</joint>

	<joint name="rgb_camera_link_to_rgb_camera_optical_frame" type="fixed">
		<parent link="rgb_camera_link"/>
		<child link="rgb_camera_optical_frame"/>
		<origin xyz="0.0 0.0 0.0" rpy="-1.57079632679 0.0 -1.57079632679"/>
	</joint>

	<!-- gpsアンテナの位置など記載 -->
	<joint name="gps_joint" type="fixed">
		<parent link="base_link"/>
		<child link="gps_link"/>
		<origin xyz="-0.02 -0.07 0.25" rpy="0 0 0"/>
	</joint>
</robot>
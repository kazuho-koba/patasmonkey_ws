# Robot Managerから操作するunitをCoreと2種類のbag recorderに限定する。
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block start-pm.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl stop start-pm.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl is-active start-pm.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGTERM --kill-who=all start-pm.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl stop pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl is-active pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block pm-debug-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl stop pm-debug-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl is-active pm-debug-bag.service

# GUI停止時の保存先未作成bagの取消。CoreへのSIGKILL権限は与えない。
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGSTOP --kill-who=all pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGCONT --kill-who=all pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGKILL --kill-who=all pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl reset-failed pm-mission-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGSTOP --kill-who=all pm-debug-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGCONT --kill-who=all pm-debug-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl kill --signal=SIGKILL --kill-who=all pm-debug-bag.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl reset-failed pm-debug-bag.service

# 走行許可unitは明示的な開始・正常停止と状態取得だけを許可する。
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block pm-vehicle-control.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl stop pm-vehicle-control.service
nvidia ALL=(root) NOPASSWD: /usr/bin/systemctl is-active pm-vehicle-control.service

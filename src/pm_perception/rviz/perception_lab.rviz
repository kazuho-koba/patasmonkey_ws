Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 60; 65; 70
  Displays:
    - Class: rviz_default_plugins/Marker
      Name: Retention boundary (orange)
      Enabled: true
      Marker Topic:
        Value: /depth_elevation_mapper/retention_boundary
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Grid
      Name: 1m Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/Map
      Name: Selected hazard (white free / black hazard / gray unknown)
      Enabled: true
      Alpha: 0.8
      Topic:
        Value: /perception_preview/selected_costmap
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (actual URDF scale)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Straight reference (blue)
      Enabled: true
      Color: 0; 150; 255
      Line Style: Billboards
      Line Width: 0.08
      Topic:
        Value: /perception_preview/reference_path
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: MPPI local preview (legacy single color)
      Enabled: false
      Color: 0; 255; 100
      Line Style: Billboards
      Line Width: 0.12
      Topic:
        Value: /perception_preview/local_path
        Durability Policy: Volatile
    - Class: rviz_default_plugins/MarkerArray
      Name: Planned speed (red slow / green fast; labels mps)
      Enabled: true
      Marker Topic:
        Value: /perception_preview/speed_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: Color image
      Enabled: true
      Topic:
        Value: /oak/color/image_raw
        Reliability Policy: Best Effort
      Transport Hint: raw
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: base_link
      Scale: 65
      X: 1.5
      Y: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 1200
  Height: 850
  Displays:
    collapsed: false

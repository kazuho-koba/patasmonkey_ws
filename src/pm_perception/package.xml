<?xml version="1.0"?>
<package format="3">
  <name>pm_perception</name>
  <version>0.1.0</version>
  <description>Lightweight local terrain perception for Patasmonkey.</description>
  <maintainer email="kazuho@example.com">kazuho</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>python3-numpy</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pm_config</exec_depend>
  <exec_depend>pm_description</exec_depend>
  <exec_depend>pm_localization</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
